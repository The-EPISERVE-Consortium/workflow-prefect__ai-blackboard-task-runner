# --- Choose a provider manually when starting pi (no automatic fallback) ---
#
# pi --provider ollama --model qwen3.5:35b       (self-hosted, native /api/chat)
# pi --provider openrouter --model <id>          (commercial, built into pi)

# Self-hosted Ollama via ollama.zib.de's native proxy route (respects
# num_ctx, unlike the OpenAI-compatible route which silently truncates
# to ~8192 tokens on this deployment). Set OLLAMA_HOST and OLLAMA_API_BASE
# to the same value.
OLLAMA_HOST=https://ollama.zib.de/ollama
OLLAMA_API_BASE=https://ollama.zib.de/ollama
OLLAMA_API_KEY=sk-...

# OpenRouter -- built into pi, just needs the key.
OPENROUTER_API_KEY=sk-or-...

# --- Legacy: generic OpenAI-/Anthropic-compatible custom provider ---
# Use with `pi --provider custom --model <id>`. Mostly superseded by the
# native ollama provider above, which doesn't have the context-truncation
# problem this path has on ollama.zib.de.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen3.5:35b
# LLM_API_TYPE=openai-completions
# LLM_PROVIDER_NAME=custom
# LLM_NUM_CTX=32768
